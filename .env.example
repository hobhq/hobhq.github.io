# Three THROWAWAY testnet keys. Never real funds. Never commit .env.
# Each needs a little ETH on Base Sepolia AND Unichain Sepolia (gas).
# PRIVATE_KEY (alice) also needs lREACT on Lasna: send Sepolia/Base Sepolia ETH to the
# Reactive faucet (1 ETH = 100 lREACT, max 5 ETH per tx) — see dev.reactive.network.
# alice: deployer + adult
PRIVATE_KEY=
# bob: second adult
BOB_KEY=
# the AI shopping agent
AGENT_KEY=

# optional
# lREACT deposited for the reactive contract
REACTIVE_FUND=2
# ETH deposited per vault for callbacks
CALLBACK_FUND=0.005
# 30 days
PERIOD_SECONDS=2592000
# BASE_RPC= / UNI_RPC= / LASNA_RPC=   override public RPCs
